rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validUserRole(role) {
      return role in ['customer', 'seller', 'driver'];
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && validUserRole(request.resource.data.role)
        && request.resource.data.keys().hasAll(['name', 'email', 'phone', 'role', 'createdAt'])
        && request.resource.data.email == request.auth.token.email;

      allow read: if signedIn();

      allow update: if signedIn() && (
        request.auth.uid == userId ||
        resource.data.role == 'admin' ||
        request.resource.data.role in ['customer', 'seller', 'driver']
      );

      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /orders/{orderId} {
      allow create: if signedIn();
      allow read: if signedIn();
      allow update: if signedIn();
      allow delete: if signedIn();
    }
  }
}